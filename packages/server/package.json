{
  "name": "@journals/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/",
    "test": "bun test",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@journals/core": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3"
  }
}
