{
  "name": "journals",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @journals/server dev",
    "dev:tui": "pnpm --filter @journals/client-tui dev",
    "build": "pnpm --recursive run build",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome format --write --staged ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3"
  }
}
