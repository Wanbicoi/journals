{
  "name": "journals",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun run --cwd packages/server dev",
    "dev:tui": "bun run --cwd packages/client-tui dev",
    "build": "bun --filter '*' build",
    "format": "bunx biome format --write .",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "prepare": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx biome format --write --staged ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.3",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3"
  },
  "workspaces": ["packages/*"]
}
