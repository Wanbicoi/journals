{
  "name": "journals",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "JOURNAL_CONFIG=configs/journal.sandbox.yaml bun run --cwd packages/server dev",
    "dev:tui": "JOURNAL_CONFIG=configs/journal.sandbox.yaml bun run --cwd packages/client-tui dev",
    "dev": "JOURNAL_CONFIG=configs/journal.sandbox.yaml bun run dev:tui",
    "seed": "JOURNAL_CONFIG=configs/journal.sandbox.yaml bun run --cwd packages/server scripts/seed.ts",
    "build": "bun --filter '*' build",
    "format": "bunx biome format --write .",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "typecheck": "bunx tsc -b --noEmit",
    "check": "bun run format && bun run lint && bun run typecheck",
    "prepare": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx biome check --write --staged --no-errors-on-unmatched && git update-index --again && bun run typecheck",
    "commit-msg": "bunx commitlint --edit \"$1\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.3",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3"
  },
  "workspaces": ["packages/*"]
}
